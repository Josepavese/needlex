# Workstation footprint baseline.
#
# This machine is treated as a space-constrained device: its root filesystem runs
# at ~100% and a few gigabytes are all the headroom local work gets. The limits
# below are the operating envelope for that device. They fail local work before
# the disk becomes unusable, and they are measured, not aspirational.
#
# Host and cache limits are enforced only on a real workstation: CI runners have
# their own disks and their own cleanup, so `check_workstation_space.sh` skips
# them when CI is set or when NEEDLEX_SKIP_DEVICE_CHECKS=1.

# Free space on the filesystem that holds the working tree, in GB.
# Below HARD, builds and tests start failing on writes: that is a gate.
# Below WARN, reclaim the regenerable caches first: a cold full rebuild plus a
# release build consumes 1-2 GB, so 4 GB is the floor that survives one heavy
# cycle without reaching the hard limit.
MIN_FREE_GB_HARD=3
MIN_FREE_GB_WARN=4

# Regenerable Go build cache. Warning only: a legitimate full rebuild plus
# benchmark builds can reach this, but it must not be left to grow.
MAX_GO_BUILD_CACHE_GB=3

# Single non-distribution file in the working tree, in MB. Excludes dist/,
# whose build output has its own cap below.
MAX_LARGE_FILE_MB=10

# Release build output. Present during a release, expected to be removed after.
MAX_DIST_MB=200

# Local analysis artifacts under improvements/. These are tracked, and they are
# not a dumping ground for benchmark runs.
MAX_IMPROVEMENTS_MB=12

# Local state that must not accumulate inside the working tree or in temp:
# repo-local runtime state directories and leftover needlex temp files, in MB.
MAX_LOCAL_STATE_MB=128
