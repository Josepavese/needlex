# Needle-X governance baseline.
# Hard limits block regressions.
# Target limits are pressure-only and should ratchet down over time.

# v0.1.34 network-aware delivery recalibration. The renderer surface admitted in
# v0.1.33 could not actually deliver captured application data: the retrieval
# substrate had 150 lines of headroom, which would have forced removing capture
# diagnostics instead of closing real gaps. The total ceiling moves once, and
# file-size discipline tightens at the same time so the new volume cannot turn
# into bigger files or new hotspots.
# 2026-10-27 strategic recalibration: measured 34,995 runtime lines after MCP
# Chromium ownership, isolated contexts and PAL process/interruptible-input
# cleanup. This adds 605 lines to the consolidated 34,390 baseline, without
# packages/dependencies. Admit that substrate, retain the LOC target and zero
# structural-issue gate, and tighten the >300-line-file ceiling from 29 to 27
# (26 observed) to offset total volume with stricter concentration control.
# 2026-10-28: admit the local typed decision observer, token-budget validation
# and advisory diagnostics (about 300 runtime lines, no new package or runtime
# dependency). Deterministic fixes remove language/payload heuristics. Keep the
# 34,500 target and every concentration/structure ceiling unchanged.
# 2026-10-29: measured 35,537 runtime lines for whole-passage claim selection,
# isolated advisory failure state, bounded MCP memo lifetime and compact scope
# diagnostics, after retiring CSS-word pruning and its genome/request profiles.
# Admit 100 lines above the former ceiling; retain the total target and tighten
# the >350-line-file ceiling from 23 to 21, target 20 (20 observed). No package/dependency
# increase. This admits a new capability, not a claimed net LOC reduction.
# 2026-10-29 acquisition policy: measured 35,983 runtime lines, service 6,768.
# Reuse the same choice adapter, dense selector, memo and trace audit owner;
# add no package/dependency or active routing engine. Admit the explicit passive
# acquisition contract and strict-render fix. Tighten >300-line files 27 -> 26
# and average file ceiling 210 -> 200 (174 observed); retain the LOC target.
HARD_MAX_PROD_LOC=36000
TARGET_MAX_PROD_LOC=34500

HARD_MAX_INTERNAL_PACKAGES=14
TARGET_MAX_INTERNAL_PACKAGES=11

# Direct imports are classified truthfully after go mod tidy. The five runtime
# dependencies cover HTTP, HTML, SQLite memory, YAML standards, and maintained
# WebSocket/CDP transport; none has a surface-equivalent standard-library path.
HARD_MAX_RUNTIME_DEPS=5
TARGET_MAX_RUNTIME_DEPS=4

HARD_MAX_FILE_LOC=1800
TARGET_MAX_FILE_LOC=1400

HARD_MAX_AVG_FILE_LOC=200
TARGET_MAX_AVG_FILE_LOC=200

HARD_MAX_FILES_OVER_300=26
TARGET_MAX_FILES_OVER_300=26

HARD_MAX_FILES_OVER_350=21
TARGET_MAX_FILES_OVER_350=20

HARD_MAX_PACKAGE_LOC=6800
TARGET_MAX_PACKAGE_LOC=6500

HARD_MAX_STRUCTURE_ISSUES=0
TARGET_MAX_STRUCTURE_ISSUES=0

REQUIRE_GOFUMPT=1
REQUIRE_GOVET=1
REQUIRE_STATICCHECK=1
REQUIRE_STRUCTURE_LINT=1
REQUIRE_ADVISORY_LINT=1
REQUIRE_BENCHMARK_ADVISORY_LINT=1
