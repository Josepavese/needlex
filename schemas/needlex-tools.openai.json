{
  "provider": "openai",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "web_crawl",
        "description": "Traverse linked pages starting from one seed URL.",
        "parameters": {
          "examples": [
            {
              "max_depth": 1,
              "max_pages": 5,
              "same_domain": true,
              "seed_url": "https://example.com/docs"
            }
          ],
          "properties": {
            "max_depth": {
              "type": "integer"
            },
            "max_pages": {
              "type": "integer"
            },
            "profile": {
              "type": "string"
            },
            "same_domain": {
              "type": "boolean"
            },
            "seed_url": {
              "type": "string"
            },
            "user_agent": {
              "type": "string"
            }
          },
          "required": [
            "seed_url"
          ],
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_query",
        "description": "Plan and execute a goal-oriented query with optional seed URL. Discovery Memory is consulted first for seedless queries; web_search is public bootstrap fallback. Use same_site_links to expand from a seed site, and off only when seed_url is the exact canonical page.",
        "parameters": {
          "examples": [
            {
              "discovery_mode": "same_site_links",
              "goal": "Find authentication flow details",
              "seed_url": "https://agentclientprotocol.com/protocol/overview"
            },
            {
              "discovery_mode": "web_search",
              "goal": "OpenAI API pricing"
            },
            {
              "discovery_mode": "off",
              "goal": "Read the verified initialize method page",
              "seed_url": "https://agentclientprotocol.com/protocol/initialization"
            }
          ],
          "properties": {
            "discovery_mode": {
              "description": "Discovery strategy. same_site_links = follow links from the seed site. web_search = bootstrap with search. off = do not expand beyond the seed URL and should be used only after the exact page has already been verified.",
              "enum": [
                "same_site_links",
                "web_search",
                "off"
              ],
              "type": "string"
            },
            "goal": {
              "description": "Retrieval objective or question to answer.",
              "type": "string"
            },
            "lane_max": {
              "type": "integer"
            },
            "profile": {
              "type": "string"
            },
            "seed_url": {
              "description": "Optional starting URL. If present, same_site_links expands from this site. When discovery_mode=off, this must be the exact canonical page and must already exist.",
              "type": "string"
            },
            "user_agent": {
              "type": "string"
            }
          },
          "required": [
            "goal"
          ],
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_read",
        "description": "Read one URL and return compact proof-carrying context first. Successful reads automatically feed local Discovery Memory and Analytics PAL for future seedless reuse.",
        "parameters": {
          "examples": [
            {
              "objective": "Extract pricing and policy details",
              "url": "https://example.com"
            }
          ],
          "properties": {
            "lane_max": {
              "type": "integer"
            },
            "objective": {
              "type": "string"
            },
            "profile": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "user_agent": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_replay",
        "description": "Replay a stored trace and report deterministic stage completion.",
        "parameters": {
          "examples": [
            {
              "trace_id": "trace_123"
            }
          ],
          "properties": {
            "trace_id": {
              "type": "string"
            }
          },
          "required": [
            "trace_id"
          ],
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_diff",
        "description": "Compare two stored traces and report changed stages.",
        "parameters": {
          "examples": [
            {
              "trace_a": "trace_a",
              "trace_b": "trace_b"
            }
          ],
          "properties": {
            "trace_a": {
              "type": "string"
            },
            "trace_b": {
              "type": "string"
            }
          },
          "required": [
            "trace_a",
            "trace_b"
          ],
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_proof",
        "description": "Load proof records by trace id, proof id, or chunk id.",
        "parameters": {
          "examples": [
            {
              "chunk_id": "chk_123"
            },
            {
              "trace_id": "trace_123"
            }
          ],
          "properties": {
            "chunk_id": {
              "type": "string"
            },
            "proof_id": {
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            }
          },
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_prune",
        "description": "Prune local traces, proofs, fingerprints, and genome files.",
        "parameters": {
          "examples": [
            {
              "older_than_hours": 24
            }
          ],
          "properties": {
            "all": {
              "type": "boolean"
            },
            "older_than_hours": {
              "type": "integer"
            }
          },
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "memory",
        "description": "Advanced non-core Discovery Memory control. Use only when explicitly inspecting or maintaining Needle-X local semantic memory; normal web retrieval already uses memory automatically. Actions: stats shows counts/freshness; search checks local semantic recall; prune applies retention policy; export/import move canonical JSONL rows; rebuild_index refreshes acceleration state.",
        "parameters": {
          "examples": [
            {
              "action": "stats"
            },
            {
              "action": "search",
              "limit": 5,
              "query": "playwright installation"
            },
            {
              "action": "export",
              "out_dir": "needlex-discovery-export"
            }
          ],
          "properties": {
            "action": {
              "description": "Required operation. Prefer stats or search for debugging; prune/export/import/rebuild_index are maintenance actions.",
              "enum": [
                "stats",
                "search",
                "prune",
                "export",
                "import",
                "rebuild_index"
              ],
              "type": "string"
            },
            "config_path": {
              "description": "Optional Needle-X JSON config path.",
              "type": "string"
            },
            "domain_hints": {
              "description": "Optional host/domain hints for action=search.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "goal": {
              "description": "Alias for query when action=search.",
              "type": "string"
            },
            "in_dir": {
              "description": "Source directory for action=import.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum rows for action=search.",
              "type": "integer"
            },
            "out_dir": {
              "description": "Destination directory for action=export.",
              "type": "string"
            },
            "query": {
              "description": "Semantic query for action=search.",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "analytics",
        "description": "Advanced non-core Analytics PAL control. Use only for diagnostics, value reporting, or maintenance; normal web_read/web_query/web_crawl record analytics automatically. Actions: value_report is the user-facing WOW report; stats/recent_runs are quick diagnostics; hosts/providers/failures/daily are maintainer rollups; export writes full analytics artifacts.",
        "parameters": {
          "examples": [
            {
              "action": "value_report"
            },
            {
              "action": "recent_runs",
              "limit": 10
            },
            {
              "action": "failures",
              "limit": 20
            },
            {
              "action": "export",
              "out_dir": "needlex-analytics-export"
            }
          ],
          "properties": {
            "action": {
              "description": "Required operation. Prefer value_report for product value, stats/recent_runs for quick debug, failures/providers for reliability analysis.",
              "enum": [
                "stats",
                "recent_runs",
                "value_report",
                "hosts",
                "providers",
                "failures",
                "daily",
                "export"
              ],
              "type": "string"
            },
            "limit": {
              "description": "Maximum rows for recent_runs, hosts, providers, failures, or daily.",
              "type": "integer"
            },
            "out_dir": {
              "description": "Destination directory for action=export.",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
      }
    }
  ]
}
